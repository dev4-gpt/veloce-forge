# Names only. Real values live in .env (Stripe Projects) and .env.local (git-ignored).
CREATEOS_SANDBOX_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEON_POSTGRES_CONNECTION_STRING=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fallback providers (used in order after Gemini; need BOTH key and model). Free tiers change and may train on prompts.
LLM_PROVIDERS=gemini,groq,openrouter,nvidia,mistral,cerebras,sambanova,huggingface,llm7
# Each fallback is used only if BOTH its key and model are set (copy the exact model id from the provider's dashboard).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
LLM7_API_KEY=
LLM7_MODEL=
# Pauses (ms) before each retry of a transient error (429/5xx/timeout) on the same provider; empty disables retries.
LLM_RETRY_DELAYS_MS=1500,4000
# Total time one model call may spend across all providers and retries (ms). Keep two of these well under the 300 s function limit.
LLM_TOTAL_BUDGET_MS=100000
# Longest a single provider call may take (ms), so a hung provider cannot use up the budget before the fallbacks run.
LLM_CALL_TIMEOUT_MS=45000
# Output tokens requested from each provider. Too low and a reasoning model's reply is cut off mid-code.
LLM_MAX_OUTPUT_TOKENS=8192
# Shared demo passcode (any string); protects rounds, approvals and demo credits
DEMO_PASSCODE=

# Optional: base64 Ed25519 PKCS8 private key that signs report-chain entries (see src/lib/evidence.ts for the one-liner to generate it)
REPORT_SIGNING_KEY=

# Optional: pay rounds with a Stripe card hold. always (default) = charge every completed round; on_green = charge only gate-passing proposals
CARD_CAPTURE_POLICY=
